# Database connection string (MongoDB)
# Local: mongodb://127.0.0.1:27017/majdur?directConnection=true
# Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/majdur?retryWrites=true&w=majority
DATABASE_URL="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/majdur?retryWrites=true&w=majority"

# Next.js App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Backend API URL
NEXT_PUBLIC_API_URL="http://localhost:5000/api"

# Authentication Secrets
JWT_SECRET="super-secret-majdur-jwt-token-key-2026-secure-random"
NEXTAUTH_SECRET="super-secret-majdur-nextauth-token-key-2026-secure-random"
NEXTAUTH_URL="http://localhost:3000"

# Razorpay credentials (Test mode)
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="placeholder_secret"

# Twilio / SMS credentials (for OTP verification)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Email service (Nodemailer / Resend / SendGrid)
EMAIL_SERVER_HOST="smtp.example.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="MajDur Support <noreply@majdur.in>"
