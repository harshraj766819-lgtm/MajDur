// MajDur Prisma Schema
// Database ORM models for blue-collar labor marketplace

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  WORKER
  CONTRACTOR
  ADMIN
}

enum JobType {
  ONE_TIME
  RECURRING
  CONTRACT
}

enum BudgetType {
  FIXED
  HOURLY
  DAILY
}

enum JobStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum BookingStatus {
  REQUESTED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REJECTED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model User {
  id                    String             @id @default(cuid())
  name                  String
  email                 String?            @unique
  phone                 String             @unique
  password              String
  role                  Role               @default(CUSTOMER)
  avatar                String?
  isPhoneVerified       Boolean            @default(false)
  isEmailVerified       Boolean            @default(false)
  otpCode               String?
  otpExpiresAt          DateTime?
  resetPasswordToken    String?
  resetPasswordExpires  DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  // Profiles
  workerProfile         WorkerProfile?
  contractorProfile     ContractorProfile?
  customerProfile       CustomerProfile?

  // Relations
  postedJobs            Job[]              @relation("UserPostedJobs")
  applications          JobApplication[]   @relation("WorkerApplications")
  customerBookings      Booking[]          @relation("CustomerBookings")
  workerBookings        Booking[]          @relation("WorkerBookings")
  reviewsGiven          Review[]           @relation("ReviewsGiven")
  reviewsReceived       Review[]           @relation("ReviewsReceived")
  payments              Payment[]
  notifications         Notification[]

  @@index([role])
  @@index([phone])
}

model WorkerProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio              String?  @db.Text
  dailyRate        Float?
  hourlyRate       Float?
  experienceYears  Int      @default(1)
  category         String   // e.g. Electrician, Plumber, Carpenter, Mason, Painter, Welder, Labourer
  categoryId       String?
  categoryRef      Category? @relation(fields: [categoryId], references: [id])
  skills           String[] @default([])
  locationCity     String
  locationState    String
  locationPincode  String
  serviceRadiusKm  Int      @default(25)
  isAvailable      Boolean  @default(true)
  isVerified       Boolean  @default(false)
  idProofType      String?  // Aadhaar, VoterID, PAN
  idProofUrl       String?
  rating           Float    @default(0)
  totalReviews     Int      @default(0)
  completedJobs    Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([category])
  @@index([locationCity])
  @@index([isVerified])
  @@index([isAvailable])
}

model ContractorProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName    String
  gstNumber      String?
  licenseNumber  String?
  city           String
  state          String
  isVerified     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model CustomerProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  address   String?
  city      String?
  state     String?
  pincode   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id            String          @id @default(cuid())
  name          String          @unique
  slug          String          @unique
  description   String?         @db.Text
  icon          String?
  baseDailyRate Float?
  workerProfiles WorkerProfile[]
  jobs          Job[]
  createdAt     DateTime        @default(now())
}

model Job {
  id            String           @id @default(cuid())
  title         String
  description   String           @db.Text
  posterId      String
  poster        User             @relation("UserPostedJobs", fields: [posterId], references: [id], onDelete: Cascade)
  categoryId    String?
  category      Category?        @relation(fields: [categoryId], references: [id])
  categoryName  String           // In case category is custom or simplified
  jobType       JobType          @default(ONE_TIME)
  budget        Float
  budgetType    BudgetType       @default(FIXED)
  city          String
  address       String
  pincode       String
  startDate     DateTime?
  endDate       DateTime?
  workersNeeded Int              @default(1)
  status        JobStatus        @default(OPEN)
  applications  JobApplication[]
  bookings      Booking[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([city])
  @@index([status])
  @@index([categoryName])
}

model JobApplication {
  id           String            @id @default(cuid())
  jobId        String
  job          Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  workerId     String
  worker       User              @relation("WorkerApplications", fields: [workerId], references: [id], onDelete: Cascade)
  proposedRate Float
  coverNote    String?           @db.Text
  status       ApplicationStatus @default(PENDING)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([jobId, workerId])
}

model Booking {
  id              String        @id @default(cuid())
  bookingNumber   String        @unique // e.g. BK-2026-0001
  customerId      String
  customer        User          @relation("CustomerBookings", fields: [customerId], references: [id], onDelete: Cascade)
  workerId        String
  worker          User          @relation("WorkerBookings", fields: [workerId], references: [id], onDelete: Cascade)
  jobId           String?
  job             Job?          @relation(fields: [jobId], references: [id], onDelete: SetNull)
  serviceCategory String
  status          BookingStatus @default(REQUESTED)
  startDate       DateTime
  endDate         DateTime?
  dailyRate       Float
  totalDays       Int           @default(1)
  totalAmount     Float
  address         String
  city            String
  notes           String?       @db.Text
  completionNotes String?       @db.Text
  completedAt     DateTime?
  reviews         Review[]
  payments        Payment[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
  @@index([customerId])
  @@index([workerId])
}

model Review {
  id           String   @id @default(cuid())
  bookingId    String
  booking      Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  reviewerId   String
  reviewer     User     @relation("ReviewsGiven", fields: [reviewerId], references: [id], onDelete: Cascade)
  targetUserId String
  targetUser   User     @relation("ReviewsReceived", fields: [targetUserId], references: [id], onDelete: Cascade)
  rating       Int      @default(5)
  comment      String?  @db.Text
  createdAt    DateTime @default(now())
}

model Payment {
  id                 String        @id @default(cuid())
  bookingId          String?
  booking            Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  userId             String
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount             Float
  currency           String        @default("INR")
  razorpayOrderId    String?
  razorpayPaymentId  String?
  razorpaySignature  String?
  status             PaymentStatus @default(PENDING)
  invoiceNumber      String?
  refundId           String?
  refundAmount       Float?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([status])
  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String   @db.Text
  type      String   @default("SYSTEM") // BOOKING, JOB, PAYMENT, SYSTEM
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}
