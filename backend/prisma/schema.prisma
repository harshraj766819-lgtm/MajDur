// MajDur Database Schema (MongoDB Provider)
// Developer: Harsh Singh
// Platform: MajDur (India's Premier Workforce & Skilled Services Marketplace)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  WORKER
  CONTRACTOR
  ADMIN
}

enum JobType {
  ONE_TIME
  RECURRING
  CONTRACT
}

enum BudgetType {
  FIXED
  HOURLY
  DAILY
}

enum JobStatus {
  DRAFT
  OPEN
  APPLICATIONS_CLOSED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ApplicationStatus {
  PENDING
  SHORTLISTED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum BookingStatus {
  REQUESTED
  ACCEPTED
  REJECTED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
  RECRUITMENT_OPEN
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum VerificationStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
}

enum ComplaintStatus {
  OPEN
  UNDER_INVESTIGATION
  RESOLVED
  CLOSED
}

model User {
  id                    String                @id @default(auto()) @map("_id") @db.ObjectId
  name                  String
  email                 String?               @unique
  phone                 String                @unique
  password              String
  role                  Role                  @default(CUSTOMER)
  avatar                String?
  isPhoneVerified       Boolean               @default(false)
  isEmailVerified       Boolean               @default(false)
  isActive              Boolean               @default(true)
  otpCode               String?
  otpExpiresAt          DateTime?
  resetPasswordToken    String?
  resetPasswordExpires  DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  // Profiles
  customerProfile       CustomerProfile?
  workerProfile         WorkerProfile?
  contractorProfile     ContractorProfile?

  // Relations
  addresses             Address[]
  postedJobs            Job[]                 @relation("PostedJobs")
  applications          JobApplication[]      @relation("WorkerApplications")
  customerBookings      Booking[]             @relation("CustomerBookings")
  workerBookings        Booking[]             @relation("WorkerBookings")
  reviewsGiven          Review[]              @relation("ReviewsGiven")
  reviewsReceived       Review[]              @relation("ReviewsReceived")
  payments              Payment[]
  notifications         Notification[]
  conversationMembers   ConversationMember[]
  messagesSent          Message[]
  complaintsFiled       Complaint[]           @relation("ComplaintsFiled")
  complaintsAgainst     Complaint[]           @relation("ComplaintsAgainst")
  verificationRequests  VerificationRequest[]
  adminAuditLogs        AdminAuditLog[]       @relation("AdminLogs")
  refreshSessions       RefreshSession[]
  passwordResetTokens   PasswordResetToken[]
  recruitmentApplications RecruitmentApplication[]
  workerAssignments     WorkerAssignment[]
  attendanceRecords     AttendanceRecord[]

  @@index([role])
}

model CustomerProfile {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  userId         String    @unique @db.ObjectId
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  alternatePhone String?
  city           String?
  state          String?
  pincode        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model WorkerProfile {
  id               String         @id @default(auto()) @map("_id") @db.ObjectId
  userId           String         @unique @db.ObjectId
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio              String?
  dailyRate        Float?
  hourlyRate       Float?
  experienceYears  Int            @default(1)
  category         String         // Primary category slug/name
  categoryId       String?        @db.ObjectId
  categoryRef      Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  locationCity     String
  locationState    String
  locationPincode  String
  serviceRadiusKm  Int            @default(25)
  isAvailable      Boolean        @default(true)
  isVerified       Boolean        @default(false)
  idProofType      String?        // Aadhaar, Voter ID, PAN
  idProofUrl       String?
  rating           Float          @default(0)
  totalReviews     Int            @default(0)
  completedJobs    Int            @default(0)
  workerSkills     WorkerSkill[]
  serviceAreas     ServiceArea[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([category])
  @@index([locationCity])
  @@index([locationPincode])
  @@index([isVerified])
  @@index([isAvailable])
  @@index([rating])
  @@index([experienceYears])
  @@index([dailyRate])
}

model ContractorProfile {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  userId          String    @unique @db.ObjectId
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName     String
  companyBio      String?
  gstNumber       String?
  licenseNumber   String?
  ownerName       String?
  businessEmail   String?
  businessPhone   String?
  businessAddress String?
  businessType    String?   @default("Private Limited")
  panNumber       String?
  companyLogo     String?
  city            String
  state           String
  pincode         String?
  isVerified      Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Phase 7 Relations
  projects        Project[]
  supervisors     Supervisor[]
  gstInvoices     GstInvoice[]

  @@index([isVerified])
}

model Category {
  id             String          @id @default(auto()) @map("_id") @db.ObjectId
  name           String          @unique
  hindiName      String?
  slug           String          @unique
  description    String?
  icon           String?
  baseDailyRate  Float?
  isActive       Boolean         @default(true)
  displayOrder   Int             @default(0)
  skills         Skill[]
  workerProfiles WorkerProfile[]
  jobs           Job[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([isActive])
}

model Skill {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  name         String        @unique
  categoryId   String        @db.ObjectId
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  workerSkills WorkerSkill[]
  jobSkills    JobSkill[]
  createdAt    DateTime      @default(now())
}

model WorkerSkill {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  workerProfileId String        @db.ObjectId
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  skillId         String        @db.ObjectId
  skill           Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)
  yearsExperience Int           @default(1)

  @@unique([workerProfileId, skillId])
}

model Address {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String   @default("Home") // Home, Work, Site
  line1      String
  line2      String?
  area       String?
  city       String
  state      String
  pincode    String
  latitude   Float?
  longitude  Float?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ServiceArea {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  workerProfileId String        @db.ObjectId
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  city            String
  pincode         String?
  areaName        String?
  radiusKm        Int           @default(20)

  @@index([city])
  @@index([pincode])
}

model Job {
  id            String           @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  description   String
  posterId      String           @db.ObjectId
  poster        User             @relation("PostedJobs", fields: [posterId], references: [id], onDelete: Cascade)
  categoryId    String?          @db.ObjectId
  category      Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryName  String
  jobType       JobType          @default(ONE_TIME)
  budget        Float
  budgetType    BudgetType       @default(FIXED)
  city          String
  area          String?
  address       String
  pincode       String
  startDate     DateTime?
  expectedDays  Int?             @default(1)
  workersNeeded Int              @default(1)
  status        JobStatus        @default(OPEN)
  skills        JobSkill[]
  applications  JobApplication[]
  bookings      Booking[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([city])
  @@index([status])
  @@index([categoryName])
}

model JobSkill {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  jobId   String @db.ObjectId
  job     Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skillId String @db.ObjectId
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([jobId, skillId])
}

model JobApplication {
  id           String            @id @default(auto()) @map("_id") @db.ObjectId
  jobId        String            @db.ObjectId
  job          Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  workerId     String            @db.ObjectId
  worker       User              @relation("WorkerApplications", fields: [workerId], references: [id], onDelete: Cascade)
  proposedRate Float
  coverNote    String?
  status       ApplicationStatus @default(PENDING)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([jobId, workerId])
  @@index([status])
}

model Booking {
  id              String                 @id @default(auto()) @map("_id") @db.ObjectId
  bookingNumber   String                 @unique // e.g. MD-2026-0001
  customerId      String                 @db.ObjectId
  customer        User                   @relation("CustomerBookings", fields: [customerId], references: [id], onDelete: Cascade)
  workerId        String                 @db.ObjectId
  worker          User                   @relation("WorkerBookings", fields: [workerId], references: [id], onDelete: Cascade)
  jobId           String?                @db.ObjectId
  job             Job?                   @relation(fields: [jobId], references: [id], onDelete: SetNull)
  serviceCategory String
  status          BookingStatus          @default(REQUESTED)
  startDate       DateTime
  endDate         DateTime?
  dailyRate       Float
  totalDays       Int                    @default(1)
  totalAmount     Float
  address         String
  city            String
  notes           String?
  completionNotes String?
  completedAt     DateTime?
  paymentStatus   String                 @default("UNPAID") // UNPAID, PENDING, PAID, FAILED, REFUND_PENDING, REFUNDED, PARTIALLY_REFUNDED
  paidAmount      Float                  @default(0)
  paidAt          DateTime?
  statusHistory   BookingStatusHistory[]
  reviews         Review[]
  payments        Payment[]
  invoices        Invoice[]
  complaints      Complaint[]
  conversations   Conversation[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([status])
  @@index([paymentStatus])
  @@index([customerId])
  @@index([workerId])
  @@index([startDate])
  @@index([city])
}

model BookingStatusHistory {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  bookingId String        @db.ObjectId
  booking   Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  status    BookingStatus
  note      String?
  changedBy String?
  createdAt DateTime      @default(now())

  @@index([bookingId])
}

model Payment {
  id                String         @id @default(auto()) @map("_id") @db.ObjectId
  bookingId         String?        @db.ObjectId
  booking           Booking?       @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  userId            String         @db.ObjectId
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workerId          String?        @db.ObjectId
  amount            Float
  amountPaise       Int            @default(0)
  platformFee       Float          @default(0)
  taxAmount         Float          @default(0)
  currency          String         @default("INR")
  receiptNumber     String?
  razorpayOrderId   String?        @unique
  razorpayPaymentId String?
  razorpaySignature String?
  paymentMethod     String?
  paymentMode       String         @default("TEST") // TEST, SANDBOX
  status            PaymentStatus  @default(PENDING)
  failureCode       String?
  failureReason     String?
  verifiedAt        DateTime?
  refundId          String?
  refundAmount      Float?
  refundReason      String?
  refundedAt        DateTime?
  notes             Json?
  events            PaymentEvent[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([status])
  @@index([userId, createdAt])
  @@index([workerId, createdAt])
  @@index([bookingId])
  @@index([razorpayPaymentId])
}

model PaymentEvent {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  paymentId String?  @db.ObjectId
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  eventId   String?
  eventType String   // ORDER_CREATED, PAYMENT_VERIFIED, PAYMENT_FAILED, WEBHOOK_CAPTURED, WEBHOOK_FAILED, REFUND_INITIATED, REFUND_COMPLETED, SIGNATURE_REJECTED
  source    String   @default("API") // API, WEBHOOK, SYSTEM
  payload   Json?
  createdAt DateTime @default(now())

  @@index([paymentId, createdAt])
  @@index([eventId])
}

model Invoice {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  invoiceNumber     String    @unique // e.g. INV-2026-0001
  bookingId         String    @db.ObjectId
  booking           Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  paymentId         String?   @db.ObjectId
  razorpayPaymentId String?
  paymentMethod     String?
  amount            Float
  taxAmount         Float     @default(0)
  totalAmount       Float
  pdfUrl            String?
  issuedAt          DateTime  @default(now())
  paidAt            DateTime?

  @@index([bookingId])
}

model Review {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  bookingId    String   @db.ObjectId
  booking      Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  reviewerId   String   @db.ObjectId
  reviewer     User     @relation("ReviewsGiven", fields: [reviewerId], references: [id], onDelete: Cascade)
  targetUserId String   @db.ObjectId
  targetUser   User     @relation("ReviewsReceived", fields: [targetUserId], references: [id], onDelete: Cascade)
  rating       Int      @default(5)
  comment      String?
  isModerated  Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@unique([bookingId, reviewerId])
  @@index([targetUserId])
}

model Notification {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  userId         String    @db.ObjectId
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  message        String
  type           String    @default("SYSTEM")
  isRead         Boolean   @default(false)
  readAt         DateTime?
  link           String?
  bookingId      String?   @db.ObjectId
  conversationId String?   @db.ObjectId
  relatedUserId  String?   @db.ObjectId
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model Conversation {
  id            String               @id @default(auto()) @map("_id") @db.ObjectId
  title         String?
  bookingId     String?              @db.ObjectId
  booking       Booking?             @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  lastMessage   String?
  lastMessageAt DateTime?
  members       ConversationMember[]
  messages      Message[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([bookingId])
  @@index([updatedAt])
}

model ConversationMember {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  conversationId String       @db.ObjectId
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String       @db.ObjectId
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  joinedAt       DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id              String       @id @default(auto()) @map("_id") @db.ObjectId
  conversationId  String       @db.ObjectId
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId        String       @db.ObjectId
  sender          User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content         String
  messageType     String       @default("TEXT")
  status          String       @default("SENT") // SENT, DELIVERED, READ
  isRead          Boolean      @default(false)
  clientMessageId String?
  readAt          DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
  @@index([clientMessageId])
}

model Complaint {
  id             String          @id @default(auto()) @map("_id") @db.ObjectId
  ticketNumber   String          @unique // e.g. CMP-2026-0001
  filedById      String          @db.ObjectId
  filedBy        User            @relation("ComplaintsFiled", fields: [filedById], references: [id], onDelete: Cascade)
  againstUserId  String?         @db.ObjectId
  againstUser    User?           @relation("ComplaintsAgainst", fields: [againstUserId], references: [id], onDelete: SetNull)
  bookingId      String?         @db.ObjectId
  booking        Booking?        @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  subject        String
  description    String
  status         ComplaintStatus @default(OPEN)
  adminNotes     String?
  resolution     String?
  resolvedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([status])
  @@index([filedById])
}

model VerificationRequest {
  id           String             @id @default(auto()) @map("_id") @db.ObjectId
  userId       String             @db.ObjectId
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  idType       String             // Aadhaar, Voter ID, PAN, Trade License
  idNumber     String?
  documentUrl  String
  status       VerificationStatus @default(PENDING)
  reviewNotes  String?
  reviewedBy   String?
  reviewedAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([status])
  @@index([userId])
}

model AdminAuditLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  adminId    String   @db.ObjectId
  admin      User     @relation("AdminLogs", fields: [adminId], references: [id], onDelete: Cascade)
  action     String   // USER_SUSPEND, ROLE_CHANGE, VERIFY_APPROVE, etc.
  targetId   String?
  targetType String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([action])
}


model RefreshSession {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @db.ObjectId
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String   @unique
  userAgent    String?
  ipAddress    String?
  isRevoked    Boolean  @default(false)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

model VerificationToken {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier   String   // phone or email
  token        String
  type         String   // PHONE_OTP, EMAIL_VERIFY
  expiresAt    DateTime
  attempts     Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([identifier])
}

model PasswordResetToken {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @db.ObjectId
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String   @unique
  expiresAt    DateTime
  isUsed       Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([userId])
}

// ==========================================
// Phase 7: Contractor & B2B Workforce Models
// ==========================================

model Project {
  id                   String               @id @default(auto()) @map("_id") @db.ObjectId
  contractorId         String               @db.ObjectId
  contractor           ContractorProfile    @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  projectCode          String               @unique // e.g. PRJ-2026-001
  name                 String
  description          String
  category             String               // Commercial, Residential, Industrial, Infrastructure, Interior
  clientName           String
  city                 String
  state                String
  pincode              String
  address              String
  startDate            DateTime
  endDate              DateTime?
  budget               Float
  status               ProjectStatus        @default(PUBLISHED)
  requiredTrades       String[]             @default([])
  totalWorkforceNeeded Int                  @default(10)
  sites                Site[]
  recruitmentRequests  RecruitmentRequest[]
  gstInvoices          GstInvoice[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([contractorId])
  @@index([status])
  @@index([city])
}

model Site {
  id                    String                 @id @default(auto()) @map("_id") @db.ObjectId
  projectId             String                 @db.ObjectId
  project               Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  siteCode              String                 // e.g. SITE-01
  name                  String
  address               String
  city                  String
  pincode               String
  siteManager           String?
  status                String                 @default("ACTIVE") // ACTIVE, ON_HOLD, COMPLETED, INACTIVE
  startDate             DateTime               @default(now())
  teams                 SiteTeam[]
  workerAssignments     WorkerAssignment[]
  supervisorAssignments SupervisorAssignment[]
  attendanceRecords     AttendanceRecord[]
  dailyReports          DailyWorkReport[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([projectId])
  @@index([status])
}

model RecruitmentRequest {
  id                      String                   @id @default(auto()) @map("_id") @db.ObjectId
  projectId               String                   @db.ObjectId
  project                 Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestNumber           String                   @unique // e.g. BR-2026-0001
  title                   String
  totalWorkersNeeded      Int
  dailyRate               Float
  shiftType               String                   @default("DAY") // DAY, NIGHT, ROTATIONAL
  workingHours            Int                      @default(8)
  requiredExperienceYears Int                      @default(2)
  recruitmentDeadline     DateTime?
  status                  String                   @default("OPEN") // OPEN, IN_REVIEW, FULFILLED, CLOSED
  notes                   String?
  tradeRequirements       Json?                    // [{ trade: "Mason", countNeeded: 20, dailyRate: 950 }, ...]
  applications            RecruitmentApplication[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  @@index([projectId])
  @@index([status])
}

model RecruitmentApplication {
  id                   String             @id @default(auto()) @map("_id") @db.ObjectId
  recruitmentRequestId String             @db.ObjectId
  recruitmentRequest   RecruitmentRequest @relation(fields: [recruitmentRequestId], references: [id], onDelete: Cascade)
  workerId             String             @db.ObjectId
  worker               User               @relation(fields: [workerId], references: [id], onDelete: Cascade)
  trade                String
  proposedRate         Float
  status               String             @default("PENDING") // PENDING, SHORTLISTED, ACCEPTED, REJECTED, WITHDRAWN
  notes                String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@unique([recruitmentRequestId, workerId])
  @@index([recruitmentRequestId])
  @@index([workerId])
  @@index([status])
}

model Supervisor {
  id             String                 @id @default(auto()) @map("_id") @db.ObjectId
  contractorId   String                 @db.ObjectId
  contractor     ContractorProfile      @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  name           String
  phone          String
  email          String?
  specialization String?
  status         String                 @default("ACTIVE") // ACTIVE, INACTIVE, ON_LEAVE
  assignments    SupervisorAssignment[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([contractorId])
}

model SupervisorAssignment {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  supervisorId String     @db.ObjectId
  supervisor   Supervisor @relation(fields: [supervisorId], references: [id], onDelete: Cascade)
  siteId       String     @db.ObjectId
  site         Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  assignedRole String     @default("Site In-Charge")
  startDate    DateTime   @default(now())
  endDate      DateTime?
  status       String     @default("ACTIVE")
  createdAt    DateTime   @default(now())

  @@index([supervisorId])
  @@index([siteId])
}

model SiteTeam {
  id              String             @id @default(auto()) @map("_id") @db.ObjectId
  siteId          String             @db.ObjectId
  site            Site               @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name            String             // e.g. "RCC Masonry Team A"
  trade           String
  teamLeaderName  String?
  teamLeaderPhone String?
  shift           String             @default("MORNING")
  assignments     WorkerAssignment[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([siteId])
}

model WorkerAssignment {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  siteId    String    @db.ObjectId
  site      Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  workerId  String    @db.ObjectId
  worker    User      @relation(fields: [workerId], references: [id], onDelete: Cascade)
  teamId    String?   @db.ObjectId
  team      SiteTeam? @relation(fields: [teamId], references: [id], onDelete: SetNull)
  trade     String
  dailyWage Float
  startDate DateTime  @default(now())
  endDate   DateTime?
  status    String    @default("ACTIVE") // ACTIVE, COMPLETED, TRANSFERRED, TERMINATED
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([siteId])
  @@index([workerId])
  @@index([status])
}

model AttendanceRecord {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  siteId        String   @db.ObjectId
  site          Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  workerId      String   @db.ObjectId
  worker        User     @relation(fields: [workerId], references: [id], onDelete: Cascade)
  date          DateTime // Date (normalized to midnight)
  status        String   // PRESENT, ABSENT, HALF_DAY, ON_LEAVE
  shift         String   @default("DAY")
  hoursWorked   Float    @default(8)
  overtimeHours Float    @default(0)
  markedBy      String
  notes         String?
  createdAt     DateTime @default(now())

  @@unique([siteId, workerId, date])
  @@index([siteId, date])
  @@index([workerId])
}

model DailyWorkReport {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  siteId             String   @db.ObjectId
  site               Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  reportDate         DateTime @default(now())
  supervisorName     String
  completedWork      String
  progressPercentage Float
  workforcePresent   Int
  pendingActivities  String?
  issuesOrDelays     String?
  photos             String[] @default([])
  createdAt          DateTime @default(now())

  @@index([siteId])
  @@index([reportDate])
}

model GstInvoice {
  id               String            @id @default(auto()) @map("_id") @db.ObjectId
  contractorId     String            @db.ObjectId
  contractor       ContractorProfile @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  projectId        String?           @db.ObjectId
  project          Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  invoiceNumber    String            @unique // e.g. MD-GST-2026-0001
  invoiceDate      DateTime          @default(now())
  dueDate          DateTime?
  placeOfSupply    String
  supplierName     String
  supplierGstin    String?
  supplierAddress  String
  supplierState    String
  recipientName    String
  recipientGstin   String?
  recipientAddress String
  recipientState   String
  sacCode          String            @default("995411")
  taxableAmount    Float
  taxType          String            // "INTRA_STATE" or "INTER_STATE"
  cgstRate         Float             @default(0)
  cgstAmount       Float             @default(0)
  sgstRate         Float             @default(0)
  sgstAmount       Float             @default(0)
  igstRate         Float             @default(0)
  igstAmount       Float             @default(0)
  totalTaxAmount   Float
  grandTotal       Float
  paymentStatus    String            @default("UNPAID") // UNPAID, PARTIALLY_PAID, PAID, OVERDUE, CANCELLED
  paidAmount       Float             @default(0)
  items            Json
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([contractorId])
  @@index([paymentStatus])
}
