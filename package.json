{
  "name": "majdur-platform",
  "version": "1.0.0",
  "private": true,
  "description": "MajDur — India's Premier Blue-Collar & Skilled Services Marketplace. Developed by Harsh Singh.",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "start:frontend": "npm --prefix frontend run start",
    "start:backend": "npm --prefix backend run start",
    "prisma:generate": "npm --prefix backend run prisma:generate",
    "prisma:push": "npm --prefix backend run prisma:push",
    "prisma:migrate": "npm --prefix backend run prisma:migrate",
    "prisma:seed": "npm --prefix backend run db:seed",
    "prisma:studio": "npm --prefix backend run prisma:studio",
    "db:test": "node scripts/test-db-connection.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.9"
  }
}
